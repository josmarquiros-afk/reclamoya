# ============================================================
#  RECLAMOYA — Variables de entorno
#  Copiá este archivo como .env en tu proyecto local
#  En Vercel: Settings → Environment Variables → agregar cada una
# ============================================================

# ── MercadoPago ──────────────────────────────────────────────
# Obtenelas en: https://www.mercadopago.com.ar/developers/panel
# Usá las de TEST primero, luego reemplazá con PRODUCCIÓN

MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# ── Anthropic (IA) ───────────────────────────────────────────
# Obtenela en: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sitio ────────────────────────────────────────────────────
# URL de tu sitio (sin barra final)
# En desarrollo: http://localhost:3000
# En producción: https://reclamoya.com.ar

SITE_URL=https://reclamoya.com.ar
